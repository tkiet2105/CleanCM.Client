                Title = "Bộ Sưu Tập Mùa Hè",
                Description = "Thời trang năng động và trẻ trung",
                ButtonText = "Khám Phá",
                ButtonAction = () => Console.WriteLine("Summer collection"),
                OverlayPosition = "TopRight",
                OverlayDark = true
            }
        };

        // 4. Different overlay positions
        positionItems = new List<TkCarrouselItem>
        {
            new TkCarrouselItem
            {
                ImageUrl = "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=1200",
                AltText = "Shoes",
                Title = "Top Left Position",
                Description = "Overlay ở góc trên bên trái",
                OverlayPosition = "TopLeft",
                OverlayDark = true
            },
            new TkCarrouselItem
            {
                ImageUrl = "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?w=1200",
