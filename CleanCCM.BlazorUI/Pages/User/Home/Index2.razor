<!-- Area/District Selection (Cà Mau wards) -->
<RadzenStack Gap="1.5rem" Class="rz-mt-4">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenText Style="font-size: var(--size-5); font-weight: 700; color: var(--md3-on-surface); margin: 0;" Class="section-title">
            Khu vực tại Cà Mau
        </RadzenText>
        @if (selectedWards.Any())
        {
            <TkButton Text="Xóa bộ lọc"
                      Icon="clear_all"
                      ButtonStyle="ButtonStyle.Secondary"
                      Variant="Variant.Outlined"
                      Size="ButtonSize.Small"
                      Click="@ClearWards"
                      Style="box-shadow: var(--shadow-sm);" />
        }
    </RadzenStack>

    <RadzenRow Gap="1rem">
        @foreach (var wardSummary in productSummary?.Wards ?? Enumerable.Empty<WardSummaryDto>())
        {
            var wardKey = wardSummary.WardKey;
            var wardName = EnumWard.GetVietnameseName(wardKey);
            var isSelected = selectedWards.Contains(wardKey);
            var displayCount = wardSummary.ProductCount;

            <RadzenStack Gap="0.75rem" AlignItems="AlignItems.Center">
                <TkButton Click="@(() => SelectWard(wardKey))"
                          Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
