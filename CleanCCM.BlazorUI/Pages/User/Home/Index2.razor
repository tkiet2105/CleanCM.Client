@page "/"
@using System.Linq
@using CleanCCM.BlazorUI.Pages.Shared
@using CleanCCM.Shared.Common
@using CleanCCM.Shared.Common.EnumString
@using CleanCCM.Shared.Products.Requests

@inject ITagClient TagClient
@inject ICategoryClient CategoryClient
@inject IProductClient ProductClient

<PageTitle>Trang chủ - Ẩm thực Cà Mau</PageTitle>

<!-- Hero Carousel -->
<div class="hero-section">
    <TkCarrousel Items="@carouselItems"
                 Height="320px"
                 AutoPlayInterval="5000"
                 ShowNavigation="true"
                 ShowIndicators="true"
                 Loop="true"
                 TransitionDuration="600"
                 ObjectFit="cover" />
</div>

<!-- Quick Stats Bar -->
<RadzenStack Class="stats-bar"
             Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.SpaceAround"
             AlignItems="AlignItems.Center"
             Gap="1rem"
             Style="margin: 1.5rem -1.5rem; padding: 1.25rem 1.5rem;">
    @foreach (var stat in quickStats)
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-md); transition: transform 0.3s ease;">
                <RadzenIcon Icon="@stat.Icon" Style="font-size: 1.5rem; color: white;" />
            </div>
            <RadzenStack Gap="0.1rem">
                <RadzenText Style="font-size: var(--size-3); font-weight: 700; color: var(--md3-on-surface); line-height: 1;">
                    @stat.Value
                </RadzenText>
                <RadzenText Style="font-size: var(--size-1); color: var(--md3-on-surface-variant); line-height: 1; font-weight: 500;">
                    @stat.Label
                </RadzenText>
            </RadzenStack>
        </RadzenStack>
    }
</RadzenStack>

<!-- Main Categories -->
<TkCategories Title="Danh mục chính"
              Categories="CategoryDtos"
              SelectedCategories="selectedMainCategories"
              GetCategoryCount="GetCategoryCount"
              CategorySelected="SelectMainCategory"
              ClearSelected="ClearCategories" />

@* <!-- Sub Categories (Tags) -->
