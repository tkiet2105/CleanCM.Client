@page "/testing"


<style>
    .category-card {
        background-color: #ffffff;
        transition: all 0.25s ease;
    }

    .category-title {
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .category-item {
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.15s ease;
    }

        .category-item:hover {
            background-color: #f3f6fc;
            transform: translateX(3px);
        }

    .hoverable:active {
        background-color: #e8f0fe;
    }
</style>
<RadzenRow>
    <RadzenColumn Size="7">
        <TkCarrousel Items="@thumbnailItems"
                     Height="300px"
                     AutoPlayInterval="4000"
                     ShowThumbnails="true"
                     ShowProgress="true"
                     ShowCounter="true" />
    </RadzenColumn>
    <RadzenColumn Size="5">
         <TkCardList Items="@categories"
                        SelectedKey="@selectedCat"
                        OnSelect="HandleCategorySelect" />
    </RadzenColumn>
</RadzenRow>


@code {

    private string? selectedCat = "all";

    private IEnumerable<TkCardList.CategoryItem> categories = new[]
    {
        new TkCardList.CategoryItem { Key = "all", Label = "Tất cả", Count = 128, Icon = "📦" },
        new TkCardList.CategoryItem { Key = "sim", Label = "SIM / eSIM", Count = 42, Icon = "📱" },
        new TkCardList.CategoryItem { Key = "box", Label = "Box Phone Farm", Count = 31, Icon = "🧰" },
        new TkCardList.CategoryItem { Key = "accessories", Label = "Phụ kiện", Count = 19, Icon = "🎧" },
        new TkCardList.CategoryItem { Key = "services", Label = "Dịch vụ", Count = 36, Icon = "🛠️" },
        // thêm để test Show all
        new TkCardList.CategoryItem { Key = "promo", Label = "Khuyến mãi", Count = 7, Icon = "🏷️" },
        new TkCardList.CategoryItem { Key = "network", Label = "Nhà mạng", Count = 14, Icon = "📡" },
        new TkCardList.CategoryItem { Key = "esim", Label = "eSIM quốc tế", Count = 22, Icon = "🌍" },
        new TkCardList.CategoryItem { Key = "gift", Label = "Quà tặng", Count = 5, Icon = "🎁" },
    };

    private Task HandleCategorySelect(string? key)
    {
        selectedCat = key;
        // TODO: lọc dữ liệu theo danh mục
        return Task.CompletedTask;
    }


    private List<TkCarrouselItem> thumbnailItems = new();
