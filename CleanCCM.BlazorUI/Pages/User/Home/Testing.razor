                AltText = "Modern architecture",
                Title = "Kiến Trúc Hiện Đại",
                Description = "Thiết kế đương đại và sáng tạo",
                                OverlayPosition = "BottomRight"

            },
            new TkCarrouselItem
            {
                ImageUrl = "https://images.unsplash.com/photo-1682687221038-404cb8830901?w=1200",
                AltText = "City skyline",
                Title = "Thành Phố Về Đêm",
                Description = "Ánh đèn rực rỡ của đô thị",
                                OverlayPosition = "BottomRight"

            },
            new TkCarrouselItem
            {
                ImageUrl = "https://images.unsplash.com/photo-1682687220063-4742bd7fd538?w=1200",
                AltText = "Urban street",
                Title = "Phố Phường Sôi Động",
                Description = "Cuộc sống nhộn nhịp của thành phố",
                            OverlayPosition = "BottomRight"
            },
            new TkCarrouselItem
            {
